NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_GOOGLE_ANALYTICS=
NEXT_PUBLIC_GOOGLE_TAG=

# Set to true only for local development if you want Keystatic to write directly
# to this checkout. Production always uses GitHub storage, regardless of this value.
NEXT_PUBLIC_KEYSTATIC_LOCAL=false

# Keystatic GitHub storage. Register an OAuth app with this callback URL:
# https://michaeldabydeen.com/api/keystatic/github/oauth/callback
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Use a long, random value. Keep it private and set it in the deployed environment.
KEYSTATIC_SECRET=
